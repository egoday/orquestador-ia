{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orquestador",
  "agents": {
    "build": {
      "permissions": [
        { "action": "shell", "resource": "python3 *", "effect": "ask" }
      ]
    }
  },
  "permissions": [
    // Rutas del destino relativas al home; OpenCode expande ~ y $HOME en
    // external_directory y edit. Ajustar si cambia la ubicación del proyecto.
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/code/rrhh/arrhh_selpro-features-listas/*", "effect": "allow" },
    { "action": "edit", "resource": "~/code/rrhh/arrhh_selpro-features-listas/*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "date *", "effect": "allow" },
    { "action": "shell", "resource": "svn status *", "effect": "allow" },
    { "action": "shell", "resource": "svn info *", "effect": "allow" },
    { "action": "shell", "resource": "svn diff *", "effect": "allow" },
    { "action": "shell", "resource": "svnversion *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" }
  ],
  "policies": [
    { "action": "tool.use", "resource": "shell:svn commit *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:svn ci *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:svn import *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:svn copy *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:svn lock *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git commit *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*mvn *deploy*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*mvn *release*", "effect": "deny" }
  ]
}
